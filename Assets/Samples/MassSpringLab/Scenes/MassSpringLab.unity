  m_Script: {fileID: 11500000, guid: be2a6b935c1c06e4f87fc9b709796210, type: 3}
  m_Name: 
  m_EditorClassIdentifier: MassSpringLab::MassSpringLab.Robot.Atom8VoiceNarrator
  audioSource: {fileID: 1163941508}
  subtitleText: {fileID: 1637200879}
  subtitleBackdrop: {fileID: 1553806688}
  cues:
  - id: 01_welcome
    subtitle: Welcome to the Mass-Spring Lab! Let's explore how mass affects spring
      extension and oscillation.
    clip: {fileID: 8300000, guid: 7e44d03e6e8f3e34d974f081bb853719, type: 3}
  - id: 02a_natural_length
    subtitle: First, let's measure the spring's natural length.
    clip: {fileID: 8300000, guid: 490c16476e5b5bd4d8a1bf94bf3ae20c, type: 3}
  - id: 02a_look_ruler
    subtitle: Look at the ruler and measure its length.
    clip: {fileID: 8300000, guid: 9b10a279e13506b40a8432519b9b6d3b, type: 3}
  - id: 02b_natural_recorded
    subtitle: Perfect! Natural length recorded.
    clip: {fileID: 8300000, guid: 7dc0d293259bbfc409bf5694e3d6fe69, type: 3}
  - id: 03_pick_50g
    subtitle: Pick up the fifty-gram mass and attach it to the spring.
    clip: {fileID: 8300000, guid: 7eeb02822e32d1c45803e01b48f54a28, type: 3}
  - id: 03_pick_100g
    subtitle: Pick up the one-hundred-gram mass and attach it to the spring.
    clip: {fileID: 8300000, guid: 3477299a3bf72234e9b3d169a1089e21, type: 3}
  - id: 03_pick_150g
    subtitle: Pick up the one-hundred-fifty-gram mass and attach it to the spring.
    clip: {fileID: 8300000, guid: b7a2ca88aac0de44fbce2989e8fe8a61, type: 3}
  - id: 03_pick_200g
    subtitle: Pick up the two-hundred-gram mass and attach it to the spring.
    clip: {fileID: 8300000, guid: 3b4ccac352f45074e9e7e5b8f5ca0ae9, type: 3}
  - id: 03_pick_250g
    subtitle: Pick up the two-hundred-fifty-gram mass and attach it to the spring.
    clip: {fileID: 8300000, guid: 524a44d774d5263419e3d840a0ec186d, type: 3}
  - id: 03b_attach_point
    subtitle: Attach the mass right here at the bottom of the spring.
    clip: {fileID: 8300000, guid: b1ff62a08cfc7f240851bed7f96229ac, type: 3}
  - id: 04a_extended_length
    subtitle: Now measure the extended length.
    clip: {fileID: 8300000, guid: f8070f15e52a8624e80f9b938eb49997, type: 3}
  - id: 04a_click_measure
    subtitle: Click the measurement button when you're ready.
    clip: {fileID: 8300000, guid: 522b02ed4124e164488f2c8355c44d49, type: 3}
  - id: 04b_extension_recorded
    subtitle: Extension recorded! Next, let's observe its motion.
    clip: {fileID: 8300000, guid: 979c602f04a10eb439f69925534cab06, type: 3}
  - id: 05a_osc_controller
    subtitle: Grab the mass, pull it gently downward, and release it.
    clip: {fileID: 8300000, guid: 0159bfdd86ea70d4e895fa3c900dd321, type: 3}
  - id: 05b_osc_hands
    subtitle: Pinch the mass, pull it gently downward, and release.
    clip: {fileID: 8300000, guid: 68b5d55b4a513814194148ccaba38059, type: 3}
  - id: 06a_oscillating
    subtitle: Watch the mass as it oscillates. I'll record the timing automatically.
    clip: {fileID: 8300000, guid: 388c131b6a918a44283d1a14e2569381, type: 3}
  - id: 06b_osc_done
    subtitle: Done! Your time period has been calculated.
    clip: {fileID: 8300000, guid: 12665eec245e2c84392a3eaeb61b92cf, type: 3}
  - id: 07_calculations
    subtitle: Let's calculate the spring constant using your measurements.
    clip: {fileID: 8300000, guid: 13a011a8eaf8d5a4ca644c66b7c9c547, type: 3}
  - id: 08_observation_table
    subtitle: Your results are recorded here. Let's review them together.
    clip: {fileID: 8300000, guid: 365d03bae9cb4944f82e2e677bab4881, type: 3}
  - id: 09_ready_proceed
    subtitle: Ready for the next mass? Click Proceed to continue.
    clip: {fileID: 8300000, guid: fde8db5600530be46a3d86ed3375239c, type: 3}
  - id: 09_next_100g
    subtitle: Let's try the one-hundred-gram mass next. Pick it up and attach it
      here.
    clip: {fileID: 8300000, guid: 7230e7f6dcc0419409425344d22315f8, type: 3}
  - id: 09_next_150g
    subtitle: Let's try the one-hundred-fifty-gram mass next. Pick it up and attach
      it here.
    clip: {fileID: 8300000, guid: 618ab6c02f649174694288a3bcfff1e7, type: 3}
  - id: 09_next_200g
    subtitle: Let's try the two-hundred-gram mass next. Pick it up and attach it
      here.
    clip: {fileID: 8300000, guid: be9dbb0dd4e8c7643a2a7c19197bb8c7, type: 3}
  - id: 09_next_250g
    subtitle: Let's try the two-hundred-fifty-gram mass next. Pick it up and attach
      it here.
    clip: {fileID: 8300000, guid: bdf49413381ab604b856b9a26bb14acd, type: 3}
  - id: 10_complete
    subtitle: Excellent work! You've completed the experiment. Let's review your
      results.
    clip: {fileID: 8300000, guid: 9d34344bf65f2d04ca0fe0863adf4bf1, type: 3}
